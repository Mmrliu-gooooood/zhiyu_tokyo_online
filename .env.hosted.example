# Copy to a secret .env.hosted.local. Never commit passwords or API keys.
# Confirmed managed project for the independent localhost cutover stack:
#   name zhiyu  ref lvbtgwlsebzbtcvjwktq
#   URL  https://lvbtgwlsebzbtcvjwktq.supabase.co
#   region ap-northeast-1
# Use only with docker-compose.supabase.yml via scripts/supabase-compose.ps1.
# Do NOT feed this file to scripts/generation-compose.ps1 or the legacy stack.

AUTH_MODE=supabase
NEXT_PUBLIC_AUTH_MODE=supabase
NEXT_PUBLIC_PERSISTENCE=1
NEXT_PUBLIC_SUPABASE_URL=https://lvbtgwlsebzbtcvjwktq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# These values are compiled into the browser bundle. Keep every protected UI
# path enabled and rebuild the image after changing any NEXT_PUBLIC_* value.
NEXT_PUBLIC_MAIC_EDITOR_ENABLED=true
NEXT_PUBLIC_PRO_WORKBENCH_ENABLED=true
NEXT_PUBLIC_MAIC_EDITOR_RENDERER_ENABLED=true
NEXT_PUBLIC_MAIC_PLAYBACK_RENDERER_ENABLED=true
NEXT_PUBLIC_PI_CHAT_ENABLED=true
NEXT_PUBLIC_LEARNING_CHECKS_ENABLED=true
NEXT_PUBLIC_GUIDED_LEARNING_ENABLED=true
NEXT_PUBLIC_TEACH_BACK_ENABLED=true
NEXT_PUBLIC_ENABLE_VIDEO_EXPORT=true
NEXT_PUBLIC_ENABLE_PPTX_IMPORT=true
# Dashboard Site URL / allow-list is http://localhost:3000 only (no 127.0.0.1).
# docker-compose.hosted.yml publishes 127.0.0.1:3001 and forces
# APP_ORIGIN=http://localhost:3001 for that overlay. Password grant against
# :3001 does not need a Site URL change. Do not feed this file to
# scripts/generation-compose.ps1.
# zhiyulearn.online is owned but not deployed; do not assume DNS or HTTPS.
APP_ORIGIN=http://localhost:3000
# Later, after the site is actually served on the domain:
# APP_ORIGIN=https://zhiyulearn.online

# LOGIN zhiyu_app_web (inherits app_web). Operator scripts only.
# Do NOT copy this into live generation-compose DATABASE_URL.
DATABASE_URL_APP_WEB=
# Dedicated app_web session/direct URL for the Web SSE wakeup bus. It may use
# the same app_web session-pooler endpoint as DATABASE_URL_APP_WEB, but never
# the app_worker login below.
DATABASE_LISTEN_URL_APP_WEB=
# Worker/queue/collector LOGIN zhiyu_app_worker. Required when AUTH_MODE=supabase.
WORKER_DATABASE_URL=
# Dedicated app_worker session/direct URL for background runner wakeups.
# Transaction-pooler URLs cannot LISTEN.
DATABASE_LISTEN_URL=
# Download the project's database CA from Supabase Dashboard > Connect > SSL.
# This host path is mounted read-only into Web, workers and readiness; the
# certificate is never copied into either image.
SUPABASE_DB_SSL_ROOT_CERT_PATH=./secrets/supabase-db-ca.crt
# Privileged postgres URI from Dashboard Connect (session/direct). Gitignored local only.
# Needed to ALTER ROLE passwords. Never paste into chat or MCP.
HOSTED_DB_ADMIN_URL=
GENERATION_MIGRATION_DATABASE_URL=

# Provision/remove scripts only. Not a Web container secret.
# SMTP is configured in the Supabase Dashboard (Resend), not here.
SUPABASE_SECRET_KEY=
# Mailbox is 2470034737@qq.com. Put the password only in gitignored local env.
# Official --apply create accepts 6+ characters. Do not store the password here.
TEST_ADMIN_EMAIL=2470034737@qq.com
TEST_ADMIN_PASSWORD=

# Shared runtime encryption/signing values. Web and both workers receive all
# three encryption keys; PRO_MODEL_ENCRYPTION_KEY is server-only but required
# by both Web and the background Pro runner (never expose it through NEXT_PUBLIC_*).
MEDIA_CONFIG_ENCRYPTION_KEY=
GENERATION_MODEL_ENCRYPTION_KEY=
PRO_MODEL_ENCRYPTION_KEY=
GENERATION_SESSION_SECRET=

# Server-only credentials for two private Supabase Storage buckets. Never use a
# publishable key here and never make either bucket public.
ASSET_BYTE_BACKEND=s3
ASSET_S3_BUCKET=zhiyu-assets
ASSET_S3_ENDPOINT=https://lvbtgwlsebzbtcvjwktq.storage.supabase.co/storage/v1/s3
ASSET_S3_REGION=ap-northeast-1
ASSET_S3_FORCE_PATH_STYLE=true
ASSET_S3_ACCESS_KEY_ID=
ASSET_S3_SECRET_ACCESS_KEY=
ASSET_BYTE_EGRESS=direct
ASSET_COLLECTION_ENABLED=false
MATERIAL_BYTE_BACKEND=s3
MATERIAL_S3_BUCKET=zhiyu-materials
CLASSROOM_S3_BUCKET=zhiyu-classrooms

# Migration/write gate. The launcher overrides this to 0 unless both
# -AcceptJobs and -ConfirmWrites are supplied after migration verification.
GENERATION_ACCEPTING_JOBS=0
GENERATION_TRUST_LEGACY_OWNER=0
OPENMAIC_AGENT_RUNTIME_ENABLED=true

# The launcher, not this file, supplies the coherent 4/8/16 capacity tuple:
# APP_HEAVY_TASK_LIMIT, APP_HEAVY_TASK_PER_OWNER_LIMIT=2,
# OPENMAIC_AGENT_RUNTIME_MAX_CONCURRENT, GENERATION_WORKER_CONCURRENCY and
# GENERATION_LLM_MAX_INFLIGHT. Queue and attention limits remain independent.
GENERATION_MAX_QUEUED_JOBS_PER_OWNER=5
GENERATION_MAX_QUEUED_JOBS=100
GENERATION_MAX_REVIEW_ATTENTION_JOBS_PER_OWNER=5
GENERATION_MAX_REVIEW_ATTENTION_JOBS=100
PARALLEL_SCENE_CONCURRENCY=1
GENERATION_TTS_CONCURRENCY=2
GENERATION_MEDIA_CONCURRENCY=1

# Preserve the existing server model/provider configuration in this private
# file. docker-compose.supabase.yml explicitly enumerates provider variables, so
# privileged operator-only values above are not copied into containers.
DEFAULT_MODEL=
MODEL_ROUTES=
ZHIYU_DEFAULT_TEXT_MODEL=
ZHIYU_DEFAULT_IMAGE_MODEL=
ZHIYU_DEFAULT_VIDEO_MODEL=
ZHIYU_DEFAULT_TTS_MODEL=
